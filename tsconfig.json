{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-dev-3456/types/**/*.ts",
    ".next-dev-3456/dev/types/**/*.ts",
    ".next-dev-skill-check/types/**/*.ts",
    ".next-dev-skill-check/dev/types/**/*.ts",
    ".next-dev-chat-pipeline/types/**/*.ts",
    ".next-dev-chat-pipeline/dev/types/**/*.ts",
    ".next-dev-only-verify/types/**/*.ts",
    ".next-dev-only-verify/dev/types/**/*.ts",
    ".next-ui-chat-fit/types/**/*.ts",
    ".next-ui-chat-fit/types/**/*.ts",
    ".next-ui-chat-fit/dev/types/**/*.ts",
    ".next-hydration-test/types/**/*.ts",
    ".next-hydration-test/dev/types/**/*.ts",
    ".next-dev-only-review/types/**/*.ts",
    ".next-dev-only-review/dev/types/**/*.ts",
    ".next-dev-runtime-hooks/types/**/*.ts",
    ".next-dev-runtime-hooks/dev/types/**/*.ts",
    ".next-hooktest/types/**/*.ts",
    ".next-hooktest/dev/types/**/*.ts",
    ".next-readiness-3446/types/**/*.ts",
    ".next-readiness-3446/dev/types/**/*.ts",
    ".next-gemini-test/types/**/*.ts",
    ".next-gemini-test/dev/types/**/*.ts",
    ".next-qr-case2/types/**/*.ts",
    ".next-qr-case2/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "types"
  ]
}
